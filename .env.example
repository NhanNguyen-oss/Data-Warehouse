# Copy to .env and fill in. .env is git-ignored; never commit real passwords.
POSTGRES_DB=road_safety_dw
POSTGRES_USER=dw
POSTGRES_PASSWORD=change-me
# PostgreSQL applies this password only when initializing an empty volume.
# Changing it later also requires updating the database role's stored password.
POSTGRES_PORT=5432

# Used by the dashboard and src/etl/pipeline.py --load.
# Match the host/port/database/user/password used by your working DB client.
# URL-encode special characters in the password (for example @ becomes %40).
# An OS-level DW_DATABASE_URL overrides the value in .env for the dashboard.
DW_DATABASE_URL=postgresql://dw:change-me@localhost:5432/road_safety_dw
